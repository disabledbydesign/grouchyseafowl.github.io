---
import BaseLayout from '../layouts/BaseLayout.astro';
---

<BaseLayout
  title="Contact"
  description="Get in touch with Dr. L. June Bloch — email, social media, and professional links."
>
  <div class="page-header">
    <h1>Contact</h1>
    <p class="subtitle">For consulting, academic inquiries, speaking, collaboration, or just saying hello.</p>
  </div>

  <div class="contact-content">
    <div class="contact-channels">
    <p class="contact-email">
      <a href="mailto:june@ljunebloch.com">june@ljunebloch.com</a>
    </p>

    <ul class="contact-links">
      <li>
        <span class="link-label">Bluesky</span>
        <a href="https://bsky.app/profile/disabledbydesign.bsky.social">@disabledbydesign.bsky.social</a>
      </li>
      <li>
        <span class="link-label">GitHub</span>
        <a href="https://github.com/disabledbydesign">disabledbydesign</a>
      </li>
      <li>
        <span class="link-label">Google Scholar</span>
        <a href="https://scholar.google.com/citations?user=9bQ8kjIAAAAJ&hl=en&oi=ao">Publication record</a>
      </li>
      <li>
        <span class="link-label">LinkedIn</span>
        <a href="https://www.linkedin.com/in/l-june-bloch-1897a329/">L. June Bloch</a>
      </li>
    </ul>
    </div>
  </div>
</BaseLayout>

<style>
  .contact-content { max-width: 65ch; }

  .contact-channels { min-width: 0; }

  .contact-email { margin-bottom: var(--space-lg); }

  .contact-email a {
    font-family: var(--font-mono);
    font-size: clamp(1.25rem, 3vw, 2rem);
    color: var(--amber);
    font-weight: 400;
    overflow-wrap: anywhere;
  }

  .contact-email a:hover { color: var(--amber-mid); }

  .contact-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: var(--space-md);
  }

  .contact-links li {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    column-gap: var(--space-md);
    row-gap: var(--space-xs);
    padding-bottom: var(--space-md);
    border-bottom: 1px solid var(--border);
  }

  .contact-links li:last-child { border-bottom: none; }

  .link-label {
    flex: 0 0 9rem;
    font-family: var(--font-body);
    font-size: var(--text-sm);
    font-weight: 500;
    color: var(--text-muted);
    text-transform: uppercase;
    letter-spacing: 0.08em;
  }

  .contact-links a {
    flex: 1 1 15rem;
    min-width: 0;
    font-size: var(--text-base);
    overflow-wrap: anywhere;
  }

</style>
